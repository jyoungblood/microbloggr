---
import "../styles/site.css";
interface Props {
  title?: string;
  feed?: boolean;
}
const { title = "Small hours", feed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content="Notes, photos, links, and recordings." />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <nav aria-label="Main navigation">
        {feed ? (
          <h1 class="site-title">
            <a href={import.meta.env.BASE_URL}>Small hours</a>
          </h1>
        ) : (
          <a href={import.meta.env.BASE_URL}>Small hours</a>
        )}
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/#posts`}>
          All posts
        </a>
      </nav>
    </header>
    <main id="main" class:list={["site-main", { "detail-page": !feed }]}>
      <slot />
    </main>
  </body>
</html>
