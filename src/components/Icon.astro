---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "search" && (
    <>
      <circle cx="9" cy="9" r="5.5" />
      <path d="m13 13 4 4" />
    </>
  )}
  {name === "theme" && (
    <>
      <circle cx="10" cy="10" r="7" />
      <path d="M10 3a7 7 0 0 0 0 14Z" fill="currentColor" />
    </>
  )}
  {name === "close" && <path d="m5 5 10 10M15 5 5 15" />}
  {name === "trash" && (
    <path d="M3.5 5.5h13M8 5.5V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5M5 5.5l.8 10.6a1 1 0 0 0 1 .9h6.4a1 1 0 0 0 1-.9L15 5.5M8.5 8.5v5.5M11.5 8.5v5.5" />
  )}
  {name === "edit" && (
    <path d="M12.5 4.5 15.5 7.5M4 16l1-4 8.5-8.5a2.1 2.1 0 0 1 3 3L8 15Z" />
  )}
  {name === "external" && <path d="M7 5h8v8M15 5 5 15" />}
  {name === "prev" && <path d="M16 10H4M9 5l-5 5 5 5" stroke-width="2" />}
  {name === "next" && <path d="M4 10h12M11 5l5 5-5 5" stroke-width="2" />}
  {name === "up" && <path d="M10 16V4M5 9l5-5 5 5" />}
  {name === "down" && <path d="M10 4v12M5 11l5 5 5-5" />}
  {name === "plus" && <path d="M10 4v12M4 10h12" />}
  {name === "grip" && (
    <path
      d="M7.5 5h0M12.5 5h0M7.5 10h0M12.5 10h0M7.5 15h0M12.5 15h0"
      stroke-width="2.5"
    />
  )}
  {name === "upload" && <path d="M10 13V3M6 7l4-4 4 4M4 13v3h12v-3" />}
</svg>
